# Keep your real key in .env, which is ignored by git.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
RAG_DATA_DIR=data/books
RAG_STORE_DIR=.rag
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# local (default): embedded exact search; server: Qdrant HTTP with HNSW support.
RAG_VECTOR_MODE=local
QDRANT_URL=http://localhost:6333
# Optional for an authenticated server; never commit real keys.
QDRANT_API_KEY=
RAG_HNSW_M=16
RAG_HNSW_EF_CONSTRUCT=100
RAG_HNSW_EF=64
# Server thresholds are KB of vector data, NOT point counts.
# For a tiny HNSW learning demo, set indexing to 1 and full-scan to 10, then rebuild.
RAG_INDEXING_THRESHOLD_KB=20000
RAG_FULL_SCAN_THRESHOLD_KB=10000
